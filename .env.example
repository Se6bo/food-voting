# ---------------------------------------------------------------------------
# Local development secrets -> copy this file to `.dev.vars` (NEVER commit it).
# Production secrets -> set via `wrangler secret put <NAME>`.
# ---------------------------------------------------------------------------

# E-Mail-Adresse, die beim Registrieren automatisch die Admin-Rolle erhaelt.
# Damit wird der erste Admin sicher eingerichtet, ohne Passwoerter im Code.
ADMIN_EMAIL="admin@example.com"

# Optionaler Einladungscode. Ist er gesetzt, muessen neue Benutzer ihn bei der
# Registrierung angeben. Leer lassen = offene Registrierung.
SIGNUP_INVITE_CODE=""

# Cookidoo-Import (optional). Eigener Cookidoo-Account des Betreibers, ueber
# den Rezepte gesucht und als Essen uebernommen werden koennen. Fehlt eine der
# beiden Variablen, bleibt das Feature deaktiviert - nichts stuerzt ab.
COOKIDOO_EMAIL="deine-cookidoo-email@example.com"
COOKIDOO_PASSWORD="dein-cookidoo-passwort"
